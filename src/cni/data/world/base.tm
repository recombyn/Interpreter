# Closed names. Open names use intro at hear time.

! rel : e
! person : e
! place : e

! me : e
! other : e
! unknown : e
! here : e
! now : e

! 机器语言TM : e
+ isa(me, 机器语言TM)
+ isa(机器语言TM, person)

# Event role / link relations (设计内核)
! agent : e
! object : e
! kind : e
! progress : e
! identity : e
! recipient : e
! destination : e
! target : e
! cause : e
! purpose : e
! manner : e
! contrast : e
! condition : e
! during : e
! before : e
! progression : e
! comparative : e
! property : e
! polarity : e
! modal : e
! mood : e
! possession : e
! emphasis : e
! farewell : e
! 开心 : e
! 伤心 : e
! 思考 : e
! 接受 : e

+ isa(agent, rel)
+ isa(object, rel)
+ isa(kind, rel)
+ isa(progress, rel)
+ isa(identity, rel)
+ isa(recipient, rel)
+ isa(destination, rel)
+ isa(target, rel)
+ isa(cause, rel)
+ isa(purpose, rel)
+ isa(manner, rel)
+ isa(contrast, rel)
+ isa(condition, rel)
+ isa(during, rel)
+ isa(before, rel)
+ isa(progression, rel)
+ isa(comparative, rel)
+ isa(property, rel)
+ isa(polarity, rel)
+ isa(modal, rel)
+ isa(mood, rel)
+ isa(possession, rel)
+ isa(emphasis, rel)

