+ isa(me, person)
+ of(content, 劳动法第100行, 第二十四条竞业限制的人员限于用人单位的高级管理人员、高级技术人员和其他负有保密义务的人员。竞业限制的范围、地域、期限由用人单位与劳动者约定，竞业限制的约定不得违反法律、法规的规定。)
+ of(content, 劳动法第101行, 在解除或者终止劳动合同后，前款规定的人员到与本单位生产或者经营同类产品、从事同类业务的有竞争关系的其他用人单位，或者自己开业生产或者经营同类产品、从事同类业务的竞业限制期限，不得超过二年。)
+ of(content, 劳动法第102行, （空行）)
+ of(content, 劳动法第103行, 第二十五条除本法第二十二条和第二十三条规定的情形外，用人单位不得与劳动者约定由劳动者承担违约金。)
+ of(content, 劳动法第104行, （空行）)
+ of(content, 劳动法第105行, 第二十六条下列劳动合同无效或者部分无效：)
+ of(content, 劳动法第106行, （一）以欺诈、胁迫的手段或者乘人之危，使对方在违背真实意思的情况下订立或者变更劳动合同的；)
+ of(content, 劳动法第107行, （二）用人单位免除自己的法定责任、排除劳动者权利的；)
+ of(content, 劳动法第108行, （三）违反法律、行政法规强制性规定的。)
+ of(content, 劳动法第109行, 对劳动合同的无效或者部分无效有争议的，由劳动争议仲裁机构或者人民法院确认。)
+ of(content, 劳动法第10行, 第一节集体合同)
+ of(content, 劳动法第110行, （空行）)
+ of(content, 劳动法第111行, 第二十七条劳动合同部分无效，不影响其他部分效力的，其他部分仍然有效。)
+ of(content, 劳动法第112行, （空行）)
+ of(content, 劳动法第113行, 第二十八条劳动合同被确认无效，劳动者已付出劳动的，用人单位应当向劳动者支付劳动报酬。劳动报酬的数额，参照本单位相同或者相近岗位劳动者的劳动报酬确定。)
+ of(content, 劳动法第114行, （空行）)
+ of(content, 劳动法第115行, ---)
+ of(content, 劳动法第116行, （空行）)
+ of(content, 劳动法第117行, 第三章劳动合同的履行和变更)
+ of(content, 劳动法第118行, 第二十九条用人单位与劳动者应当按照劳动合同的约定，全面履行各自的义务。)
+ of(content, 劳动法第119行, （空行）)
+ of(content, 劳动法第11行, 第二节劳务派遣)
+ of(content, 劳动法第120行, 第三十条用人单位应当按照劳动合同约定和国家规定，向劳动者及时足额支付劳动报酬。)
+ of(content, 劳动法第121行, 用人单位拖欠或者未足额支付劳动报酬的，劳动者可以依法向当地人民法院申请支付令，人民法院应当依法发出支付令。)
+ of(content, 劳动法第122行, （空行）)
+ of(content, 劳动法第123行, 第三十一条用人单位应当严格执行劳动定额标准，不得强迫或者变相强迫劳动者加班。用人单位安排加班的，应当按照国家有关规定向劳动者支付加班费。)
+ of(content, 劳动法第124行, （空行）)
+ of(content, 劳动法第125行, 第三十二条劳动者拒绝用人单位管理人员违章指挥、强令冒险作业的，不视为违反劳动合同。)
+ of(content, 劳动法第126行, 劳动者对危害生命安全和身体健康的劳动条件，有权对用人单位提出批评、检举和控告。)
+ of(content, 劳动法第127行, （空行）)
+ of(content, 劳动法第128行, 第三十三条用人单位变更名称、法定代表人、主要负责人或者投资人等事项，不影响劳动合同的履行。)
+ of(content, 劳动法第129行, （空行）)
+ of(content, 劳动法第12行, 第三节非全日制用工)
+ of(content, 劳动法第130行, 第三十四条用人单位发生合并或者分立等情况，原劳动合同继续有效，劳动合同由承继其权利和义务的用人单位继续履行。)
+ of(content, 劳动法第131行, （空行）)
+ of(content, 劳动法第132行, 第三十五条用人单位与劳动者协商一致，可以变更劳动合同约定的内容。变更劳动合同，应当采用书面形式。)
+ of(content, 劳动法第133行, 变更后的劳动合同文本由用人单位和劳动者各执一份。)
+ of(content, 劳动法第134行, （空行）)
+ of(content, 劳动法第135行, ---)
+ of(content, 劳动法第136行, （空行）)
+ of(content, 劳动法第137行, 第四章劳动合同的解除和终止)
+ of(content, 劳动法第138行, 第三十六条用人单位与劳动者协商一致，可以解除劳动合同。)
+ of(content, 劳动法第139行, （空行）)
+ of(content, 劳动法第13行, 第六章监督检查)
+ of(content, 劳动法第140行, 第三十七条劳动者提前三十日以书面形式通知用人单位，可以解除劳动合同。劳动者在试用期内提前三日通知用人单位，可以解除劳动合同。)
+ of(content, 劳动法第141行, （空行）)
+ of(content, 劳动法第142行, 第三十八条用人单位有下列情形之一的，劳动者可以解除劳动合同：)
+ of(content, 劳动法第143行, （一）未按照劳动合同约定提供劳动保护或者劳动条件的；)
+ of(content, 劳动法第144行, （二）未及时足额支付劳动报酬的；)
+ of(content, 劳动法第145行, （三）未依法为劳动者缴纳社会保险费的；)
+ of(content, 劳动法第146行, （四）用人单位的规章制度违反法律、法规的规定，损害劳动者权益的；)
+ of(content, 劳动法第147行, （五）因本法第二十六条第一款规定的情形致使劳动合同无效的；)
+ of(content, 劳动法第148行, （六）法律、行政法规规定劳动者可以解除劳动合同的其他情形。)
+ of(content, 劳动法第149行, 用人单位以暴力、威胁或者非法限制人身自由的手段强迫劳动者劳动的，或者用人单位违章指挥、强令冒险作业危及劳动者人身安全的，劳动者可以立即解除劳动合同，不需事先告知用人单位。)
+ of(content, 劳动法第14行, 第七章法律责任)
+ of(content, 劳动法第150行, （空行）)
+ of(content, 劳动法第151行, 第三十九条劳动者有下列情形之一的，用人单位可以解除劳动合同：)
+ of(content, 劳动法第152行, （一）在试用期间被证明不符合录用条件的；)
+ of(content, 劳动法第153行, （二）严重违反用人单位的规章制度的；)
+ of(content, 劳动法第154行, （三）严重失职，营私舞弊，给用人单位造成重大损害的；)
+ of(content, 劳动法第155行, （四）劳动者同时与其他用人单位建立劳动关系，对完成本单位的工作任务造成严重影响，或者经用人单位提出，拒不改正的；)
+ of(content, 劳动法第156行, （五）因本法第二十六条第一款第一项规定的情形致使劳动合同无效的；)
+ of(content, 劳动法第157行, （六）被依法追究刑事责任的。)
+ of(content, 劳动法第158行, （空行）)
+ of(content, 劳动法第159行, 第四十条有下列情形之一的，用人单位提前三十日以书面形式通知劳动者本人或者额外支付劳动者一个月工资后，可以解除劳动合同：)
+ of(content, 劳动法第15行, 第八章附则)
+ of(content, 劳动法第160行, （一）劳动者患病或者非因工负伤，在规定的医疗期满后不能从事原工作，也不能从事由用人单位另行安排的工作的；)
+ of(content, 劳动法第161行, （二）劳动者不能胜任工作，经过培训或者调整工作岗位，仍不能胜任工作的；)
+ of(content, 劳动法第162行, （三）劳动合同订立时所依据的客观情况发生重大变化，致使劳动合同无法履行，经用人单位与劳动者协商，未能就变更劳动合同内容达成协议的。)
+ of(content, 劳动法第163行, （空行）)
+ of(content, 劳动法第164行, 第四十一条有下列情形之一，需要裁减人员二十人以上或者裁减不足二十人但占企业职工总数百分之十以上的，用人单位提前三十日向工会或者全体职工说明情况，听取工会或者职工的意见后，裁减人员方案经向劳动行政部门报告，可以裁减人员：)
+ of(content, 劳动法第165行, （一）依照企业破产法规定进行重整的；)
+ of(content, 劳动法第166行, （二）生产经营发生严重困难的；)
+ of(content, 劳动法第167行, （三）企业转产、重大技术革新或者经营方式调整，经变更劳动合同后，仍需裁减人员的；)
+ of(content, 劳动法第168行, （四）其他因劳动合同订立时所依据的客观经济情况发生重大变化，致使劳动合同无法履行的。)
+ of(content, 劳动法第169行, 裁减人员时，应当优先留用下列人员：)
+ of(content, 劳动法第16行, （空行）)
+ of(content, 劳动法第170行, （一）与本单位订立较长期限的固定期限劳动合同的；)
+ of(content, 劳动法第171行, （二）与本单位订立无固定期限劳动合同的；)
+ of(content, 劳动法第172行, （三）家庭无其他就业人员，有需要扶养的老人或者未成年人的。)
+ of(content, 劳动法第173行, 用人单位依照本条第一款规定裁减人员，在六个月内重新招用人员的，应当通知被裁减的人员，并在同等条件下优先招用被裁减的人员。)
+ of(content, 劳动法第174行, （空行）)
+ of(content, 劳动法第175行, 第四十二条劳动者有下列情形之一的，用人单位不得依照本法第四十条、第四十一条的规定解除劳动合同：)
+ of(content, 劳动法第176行, （一）从事接触职业病危害作业的劳动者未进行离岗前职业健康检查，或者疑似职业病病人在诊断或者医学观察期间的；)
+ of(content, 劳动法第177行, （二）在本单位患职业病或者因工负伤并被确认丧失或者部分丧失劳动能力的；)
+ of(content, 劳动法第178行, （三）患病或者非因工负伤，在规定的医疗期内的；)
+ of(content, 劳动法第179行, （四）女职工在孕期、产期、哺乳期的；)
+ of(content, 劳动法第17行, ---)
+ of(content, 劳动法第180行, （五）在本单位连续工作满十五年，且距法定退休年龄不足五年的；)
+ of(content, 劳动法第181行, （六）法律、行政法规规定的其他情形。)
+ of(content, 劳动法第182行, （空行）)
+ of(content, 劳动法第183行, 第四十三条用人单位单方解除劳动合同，应当事先将理由通知工会。用人单位违反法律、行政法规规定或者劳动合同约定的，工会有权要求用人单位纠正。用人单位应当研究工会的意见，并将处理结果书面通知工会。)
+ of(content, 劳动法第184行, （空行）)
+ of(content, 劳动法第185行, 第四十四条有下列情形之一的，劳动合同终止：)
+ of(content, 劳动法第186行, （一）劳动合同期满的；)
+ of(content, 劳动法第187行, （二）劳动者开始依法享受基本养老保险待遇的；)
+ of(content, 劳动法第188行, （三）劳动者死亡，或者被人民法院宣告死亡或者宣告失踪的；)
+ of(content, 劳动法第189行, （四）用人单位被依法宣告破产的；)
+ of(content, 劳动法第18行, （空行）)
+ of(content, 劳动法第190行, （五）用人单位被吊销营业执照、责令关闭、撤销或者用人单位决定提前解散的；)
+ of(content, 劳动法第191行, （六）法律、行政法规规定的其他情形。)
+ of(content, 劳动法第192行, （空行）)
+ of(content, 劳动法第193行, 第四十五条劳动合同期满，有本法第四十二条规定情形之一的，劳动合同应当续延至相应的情形消失时终止。但是，本法第四十二条第二项规定丧失或者部分丧失劳动能力劳动者的劳动合同的终止，按照国家有关工伤保险的规定执行。)
+ of(content, 劳动法第194行, （空行）)
+ of(content, 劳动法第195行, 第四十六条有下列情形之一的，用人单位应当向劳动者支付经济补偿：)
+ of(content, 劳动法第196行, （一）劳动者依照本法第三十八条规定解除劳动合同的；)
+ of(content, 劳动法第197行, （二）用人单位依照本法第三十六条规定向劳动者提出解除劳动合同并与劳动者协商一致解除劳动合同的；)
+ of(content, 劳动法第198行, （三）用人单位依照本法第四十条规定解除劳动合同的；)
+ of(content, 劳动法第199行, （四）用人单位依照本法第四十一条第一款规定解除劳动合同的；)
+ of(content, 劳动法第19行, 第一章总则)
+ of(content, 劳动法第1行, 中华人民共和国劳动合同法)
+ of(content, 劳动法第200行, （五）除用人单位维持或者提高劳动合同约定条件续订劳动合同，劳动者不同意续订的情形外，依照本法第四十四条第一项规定终止固定期限劳动合同的；)
+ of(content, 劳动法第201行, （六）依照本法第四十四条第四项、第五项规定终止劳动合同的；)
+ of(content, 劳动法第202行, （七）法律、行政法规规定的其他情形。)
+ of(content, 劳动法第203行, （空行）)
+ of(content, 劳动法第204行, 第四十七条经济补偿按劳动者在本单位工作的年限，每满一年支付一个月工资的标准向劳动者支付。六个月以上不满一年的，按一年计算；不满六个月的，向劳动者支付半个月工资的经济补偿。)
+ of(content, 劳动法第205行, 劳动者月工资高于用人单位所在直辖市、设区的市级人民政府公布的本地区上年度职工月平均工资三倍的，向其支付经济补偿的标准按职工月平均工资三倍的数额支付，向其支付经济补偿的年限最高不超过十二年。)
+ of(content, 劳动法第206行, 本条所称月工资是指劳动者在劳动合同解除或者终止前十二个月的平均工资。)
+ of(content, 劳动法第207行, （空行）)
+ of(content, 劳动法第208行, 第四十八条用人单位违反本法规定解除或者终止劳动合同，劳动者要求继续履行劳动合同的，用人单位应当继续履行；劳动者不要求继续履行劳动合同或者劳动合同已经不能继续履行的，用人单位应当依照本法第八十七条规定支付赔偿金。)
+ of(content, 劳动法第209行, （空行）)
+ of(content, 劳动法第20行, 第一条为了完善劳动合同制度，明确劳动合同双方当事人的权利和义务，保护劳动者的合法权益，构建和发展和谐稳定的劳动关系，制定本法。)
+ of(content, 劳动法第210行, 第四十九条国家采取措施，建立健全劳动者社会保险关系跨地区转移接续制度。)
+ of(content, 劳动法第211行, （空行）)
+ of(content, 劳动法第212行, 第五十条用人单位应当在解除或者终止劳动合同时出具解除或者终止劳动合同的证明，并在十五日内为劳动者办理档案和社会保险关系转移手续。)
+ of(content, 劳动法第213行, 劳动者应当按照双方约定，办理工作交接。用人单位依照本法有关规定应当向劳动者支付经济补偿的，在办结工作交接时支付。)
+ of(content, 劳动法第214行, 用人单位对已经解除或者终止的劳动合同的文本，至少保存二年备查。)
+ of(content, 劳动法第215行, （空行）)
+ of(content, 劳动法第216行, ---)
+ of(content, 劳动法第217行, （空行）)
+ of(content, 劳动法第218行, 第五章特别规定)
+ of(content, 劳动法第219行, 第一节集体合同)
+ of(content, 劳动法第21行, （空行）)
+ of(content, 劳动法第220行, 第五十一条企业职工一方与用人单位通过平等协商，可以就劳动报酬、工作时间、休息休假、劳动安全卫生、保险福利等事项订立集体合同。集体合同草案应当提交职工代表大会或者全体职工讨论通过。)
+ of(content, 劳动法第221行, 集体合同由工会代表企业职工一方与用人单位订立；尚未建立工会的用人单位，由上级工会指导劳动者推举的代表与用人单位订立。)
+ of(content, 劳动法第222行, （空行）)
+ of(content, 劳动法第223行, 第五十二条企业职工一方与用人单位可以订立劳动安全卫生、女职工权益保护、工资调整机制等专项集体合同。)
+ of(content, 劳动法第224行, （空行）)
+ of(content, 劳动法第225行, 第五十三条在县级以下区域内，建筑业、采矿业、餐饮服务业等行业可以由工会与企业方面代表订立行业性集体合同，或者订立区域性集体合同。)
+ of(content, 劳动法第226行, （空行）)
+ of(content, 劳动法第227行, 第五十四条集体合同订立后，应当报送劳动行政部门；劳动行政部门自收到集体合同文本之日起十五日内未提出异议的，集体合同即行生效。)
+ of(content, 劳动法第228行, 依法订立的集体合同对用人单位和劳动者具有约束力。行业性、区域性集体合同对当地本行业、本区域的用人单位和劳动者具有约束力。)
+ of(content, 劳动法第229行, （空行）)
+ of(content, 劳动法第22行, 第二条中华人民共和国境内的企业、个体经济组织、民办非企业单位等组织（以下称用人单位）与劳动者建立劳动关系，订立、履行、变更、解除或者终止劳动合同，适用本法。)
+ of(content, 劳动法第230行, 第五十五条集体合同中劳动报酬和劳动条件等标准不得低于当地人民政府规定的最低标准；用人单位与劳动者订立的劳动合同中劳动报酬和劳动条件等标准不得低于集体合同规定的标准。)
+ of(content, 劳动法第231行, （空行）)
+ of(content, 劳动法第232行, 第五十六条用人单位违反集体合同，侵犯职工劳动权益的，工会可以依法要求用人单位承担责任；因履行集体合同发生争议，经协商解决不成的，工会可以依法申请仲裁、提起诉讼。)
+ of(content, 劳动法第233行, （空行）)
+ of(content, 劳动法第234行, 第二节劳务派遣)
+ of(content, 劳动法第235行, 第五十七条经营劳务派遣业务应当具备下列条件：)
+ of(content, 劳动法第236行, （一）注册资本不得少于人民币二百万元；)
+ of(content, 劳动法第237行, （二）有与开展业务相适应的固定的经营场所和设施；)
+ of(content, 劳动法第238行, （三）有符合法律、行政法规规定的劳务派遣管理制度；)
+ of(content, 劳动法第239行, （四）法律、行政法规规定的其他条件。)
+ of(content, 劳动法第23行, 国家机关、事业单位、社会团体和与其建立劳动关系的劳动者，订立、履行、变更、解除或者终止劳动合同，依照本法执行。)
+ of(content, 劳动法第240行, 经营劳务派遣业务，应当向劳动行政部门依法申请行政许可；经许可的，依法办理相应的公司登记。未经许可，任何单位和个人不得经营劳务派遣业务。)
+ of(content, 劳动法第241行, （空行）)
+ of(content, 劳动法第242行, 第五十八条劳务派遣单位是本法所称用人单位，应当履行用人单位对劳动者的义务。劳务派遣单位与被派遣劳动者订立的劳动合同，除应当载明本法第十七条规定的事项外，还应当载明被派遣劳动者的用工单位以及派遣期限、工作岗位等情况。)
+ of(content, 劳动法第243行, 劳务派遣单位应当与被派遣劳动者订立二年以上的固定期限劳动合同，按月支付劳动报酬；被派遣劳动者在无工作期间，劳务派遣单位应当按照所在地人民政府规定的最低工资标准，向其按月支付报酬。)
+ of(content, 劳动法第244行, （空行）)
+ of(content, 劳动法第245行, 第五十九条劳务派遣单位派遣劳动者应当与接受以劳务派遣形式用工的单位（以下称用工单位）订立劳务派遣协议。劳务派遣协议应当约定派遣岗位和人员数量、派遣期限、劳动报酬和社会保险费的数额与支付方式以及违反协议的责任。)
+ of(content, 劳动法第246行, 用工单位应当根据工作岗位的实际需要与劳务派遣单位确定派遣期限，不得将连续用工期限分割订立数个短期劳务派遣协议。)
+ of(content, 劳动法第247行, （空行）)
+ of(content, 劳动法第248行, 第六十条劳务派遣单位应当将劳务派遣协议的内容告知被派遣劳动者。)
+ of(content, 劳动法第249行, 劳务派遣单位不得克扣用工单位按照劳务派遣协议支付给被派遣劳动者的劳动报酬。)
+ of(content, 劳动法第24行, （空行）)
+ of(content, 劳动法第250行, 劳务派遣单位和用工单位不得向被派遣劳动者收取费用。)
+ of(content, 劳动法第251行, （空行）)
+ of(content, 劳动法第252行, 第六十一条劳务派遣单位跨地区派遣劳动者的，被派遣劳动者享有的劳动报酬和劳动条件，按照用工单位所在地的标准执行。)
+ of(content, 劳动法第253行, （空行）)
+ of(content, 劳动法第254行, 第六十二条用工单位应当履行下列义务：)
+ of(content, 劳动法第255行, （一）执行国家劳动标准，提供相应的劳动条件和劳动保护；)
+ of(content, 劳动法第256行, （二）告知被派遣劳动者的工作要求和劳动报酬；)
+ of(content, 劳动法第257行, （三）支付加班费、绩效奖金，提供与工作岗位相关的福利待遇；)
+ of(content, 劳动法第258行, （四）对在岗被派遣劳动者进行工作岗位所必需的培训；)
+ of(content, 劳动法第259行, （五）连续用工的，实行正常的工资调整机制。)
+ of(content, 劳动法第25行, 第三条订立劳动合同，应当遵循合法、公平、平等自愿、协商一致、诚实信用的原则。)
+ of(content, 劳动法第260行, 用工单位不得将被派遣劳动者再派遣到其他用人单位。)
+ of(content, 劳动法第261行, （空行）)
+ of(content, 劳动法第262行, 第六十三条被派遣劳动者享有与用工单位的劳动者同工同酬的权利。用工单位应当按照同工同酬原则，对被派遣劳动者与本单位同类岗位的劳动者实行相同的劳动报酬分配办法。用工单位无同类岗位劳动者的，参照用工单位所在地相同或者相近岗位劳动者的劳动报酬确定。)
+ of(content, 劳动法第263行, （空行）)
+ of(content, 劳动法第264行, 第六十四条被派遣劳动者有权在劳务派遣单位或者用工单位依法参加或者组织工会，维护自身的合法权益。)
+ of(content, 劳动法第265行, （空行）)
+ of(content, 劳动法第266行, 第六十五条被派遣劳动者可以依照本法第三十六条、第三十八条的规定与劳务派遣单位解除劳动合同。)
+ of(content, 劳动法第267行, 被派遣劳动者有本法第三十九条和第四十条第一项、第二项规定情形的，用工单位可以将劳动者退回劳务派遣单位，劳务派遣单位依照本法有关规定，可以与劳动者解除劳动合同。)
+ of(content, 劳动法第268行, （空行）)
+ of(content, 劳动法第269行, 第六十六条劳动合同用工是我国的企业基本用工形式。劳务派遣用工是补充形式，只能在临时性、辅助性或者替代性的工作岗位上实施。)
+ of(content, 劳动法第26行, 依法订立的劳动合同具有约束力，用人单位与劳动者应当履行劳动合同约定的义务。)
+ of(content, 劳动法第270行, （空行）)
+ of(content, 劳动法第271行, 第六十七条用人单位不得设立劳务派遣单位向本单位或者所属单位派遣劳动者。)
+ of(content, 劳动法第272行, （空行）)
+ of(content, 劳动法第273行, 第三节非全日制用工)
+ of(content, 劳动法第274行, 第六十八条非全日制用工，是指以小时计酬为主，劳动者在同一用人单位一般平均每日工作时间不超过四小时，每周工作时间累计不超过二十四小时的用工形式。)
+ of(content, 劳动法第275行, （空行）)
+ of(content, 劳动法第276行, 第六十九条非全日制用工双方当事人可以订立口头协议。)
+ of(content, 劳动法第277行, 从事非全日制用工的劳动者可以与一个或者一个以上用人单位订立劳动合同；但是，后订立的劳动合同不得影响先订立的劳动合同的履行。)
+ of(content, 劳动法第278行, （空行）)
+ of(content, 劳动法第279行, 第七十条非全日制用工双方当事人不得约定试用期。)
+ of(content, 劳动法第27行, （空行）)
+ of(content, 劳动法第280行, （空行）)
+ of(content, 劳动法第281行, 第七十一条非全日制用工双方当事人任何一方都可以随时通知对方终止用工。终止用工，用人单位不向劳动者支付经济补偿。)
+ of(content, 劳动法第282行, （空行）)
+ of(content, 劳动法第283行, 第七十二条非全日制用工小时计酬标准不得低于用人单位所在地人民政府规定的最低小时工资标准。)
+ of(content, 劳动法第284行, 非全日制用工劳动报酬结算支付周期最长不得超过十五日。)
+ of(content, 劳动法第285行, （空行）)
+ of(content, 劳动法第286行, ---)
+ of(content, 劳动法第287行, （空行）)
+ of(content, 劳动法第288行, 第六章监督检查)
+ of(content, 劳动法第289行, 第七十三条国务院劳动行政部门负责全国劳动合同制度实施的监督管理。)
+ of(content, 劳动法第28行, 第四条用人单位应当依法建立和完善劳动规章制度，保障劳动者享有劳动权利、履行劳动义务。)
+ of(content, 劳动法第290行, 县级以上地方人民政府劳动行政部门负责本行政区域内劳动合同制度实施的监督管理。)
+ of(content, 劳动法第291行, 县级以上各级人民政府劳动行政部门在劳动合同制度实施的监督管理工作中，应当听取工会、企业方面代表以及有关行业主管部门的意见。)
+ of(content, 劳动法第292行, （空行）)
+ of(content, 劳动法第293行, 第七十四条县级以上地方人民政府劳动行政部门依法对下列实施劳动合同制度的情况进行监督检查：)
+ of(content, 劳动法第294行, （一）用人单位制定直接涉及劳动者切身利益的规章制度及其执行的情况；)
+ of(content, 劳动法第295行, （二）用人单位与劳动者订立和解除劳动合同的情况；)
+ of(content, 劳动法第296行, （三）劳务派遣单位和用工单位遵守劳务派遣有关规定的情况；)
+ of(content, 劳动法第297行, （四）用人单位遵守国家关于劳动者工作时间和休息休假规定的情况；)
+ of(content, 劳动法第298行, （五）用人单位支付劳动合同约定的劳动报酬和执行最低工资标准的情况；)
+ of(content, 劳动法第299行, （六）用人单位参加各项社会保险和缴纳社会保险费的情况；)
+ of(content, 劳动法第29行, 用人单位在制定、修改或者决定有关劳动报酬、工作时间、休息休假、劳动安全卫生、保险福利、职工培训、劳动纪律以及劳动定额管理等直接涉及劳动者切身利益的规章制度或者重大事项时，应当经职工代表大会或者全体职工讨论，提出方案和意见，与工会或者职工代表平等协商确定。)
+ of(content, 劳动法第2行, （2007年6月29日第十届全国人民代表大会常务委员会第二十八次会议通过，2012年修正）)
+ of(content, 劳动法第300行, （七）法律、法规规定的其他劳动监察事项。)
+ of(content, 劳动法第301行, （空行）)
+ of(content, 劳动法第302行, 第七十五条县级以上地方人民政府劳动行政部门实施监督检查时，有权查阅与劳动合同、集体合同有关的材料，有权对劳动场所进行实地检查，用人单位和劳动者都应当如实提供有关情况和材料。)
+ of(content, 劳动法第303行, 劳动行政部门的工作人员进行监督检查，应当出示证件，依法行使职权，文明执法。)
+ of(content, 劳动法第304行, （空行）)
+ of(content, 劳动法第305行, 第七十六条县级以上人民政府建设、卫生、安全生产监督管理等有关主管部门在各自职责范围内，对用人单位执行劳动合同制度的情况进行监督管理。)
+ of(content, 劳动法第306行, （空行）)
+ of(content, 劳动法第307行, 第七十七条劳动者合法权益受到侵害的，有权要求有关部门依法处理，或者依法申请仲裁、提起诉讼。)
+ of(content, 劳动法第308行, （空行）)
+ of(content, 劳动法第309行, 第七十八条工会依法维护劳动者的合法权益，对用人单位履行劳动合同、集体合同的情况进行监督。用人单位违反劳动法律、法规和劳动合同、集体合同的，工会有权提出意见或者要求纠正；劳动者申请仲裁、提起诉讼的，工会依法给予支持和帮助。)
+ of(content, 劳动法第30行, 在规章制度和重大事项决定实施过程中，工会或者职工认为不适当的，有权向用人单位提出，通过协商予以修改完善。)
+ of(content, 劳动法第310行, （空行）)
+ of(content, 劳动法第311行, 第七十九条任何组织或者个人对违反本法的行为都有权举报，县级以上人民政府劳动行政部门应当及时核实、处理，并对举报有功人员给予奖励。)
+ of(content, 劳动法第312行, （空行）)
+ of(content, 劳动法第313行, ---)
+ of(content, 劳动法第314行, （空行）)
+ of(content, 劳动法第315行, 第七章法律责任)
+ of(content, 劳动法第316行, 第八十条用人单位直接涉及劳动者切身利益的规章制度违反法律、法规规定的，由劳动行政部门责令改正，给予警告；给劳动者造成损害的，应当承担赔偿责任。)
+ of(content, 劳动法第317行, （空行）)
+ of(content, 劳动法第318行, 第八十一条用人单位提供的劳动合同文本未载明本法规定的劳动合同必备条款或者用人单位未将劳动合同文本交付劳动者的，由劳动行政部门责令改正；给劳动者造成损害的，应当承担赔偿责任。)
+ of(content, 劳动法第319行, （空行）)
+ of(content, 劳动法第31行, 用人单位应当将直接涉及劳动者切身利益的规章制度和重大事项决定公示，或者告知劳动者。)
+ of(content, 劳动法第320行, 第八十二条用人单位自用工之日起超过一个月不满一年未与劳动者订立书面劳动合同的，应当向劳动者每月支付二倍的工资。)
+ of(content, 劳动法第321行, 用人单位违反本法规定不与劳动者订立无固定期限劳动合同的，自应当订立无固定期限劳动合同之日起向劳动者每月支付二倍的工资。)
+ of(content, 劳动法第322行, （空行）)
+ of(content, 劳动法第323行, 第八十三条用人单位违反本法规定与劳动者约定试用期的，由劳动行政部门责令改正；违法约定的试用期已经履行的，由用人单位以劳动者试用期满月工资为标准，按已经履行的超过法定试用期的期间向劳动者支付赔偿金。)
+ of(content, 劳动法第324行, （空行）)
+ of(content, 劳动法第325行, 第八十四条用人单位违反本法规定，扣押劳动者居民身份证等证件的，由劳动行政部门责令限期退还劳动者本人，并依照有关法律规定给予处罚。)
+ of(content, 劳动法第326行, 用人单位违反本法规定，以担保或者其他名义向劳动者收取财物的，由劳动行政部门责令限期退还劳动者本人，并以每人五百元以上二千元以下的标准处以罚款；给劳动者造成损害的，应当承担赔偿责任。)
+ of(content, 劳动法第327行, 劳动者依法解除或者终止劳动合同，用人单位扣押劳动者档案或者其他物品的，依照前款规定处罚。)
+ of(content, 劳动法第328行, （空行）)
+ of(content, 劳动法第329行, 第八十五条用人单位有下列情形之一的，由劳动行政部门责令限期支付劳动报酬、加班费或者经济补偿；劳动报酬低于当地最低工资标准的，应当支付其差额部分；逾期不支付的，责令用人单位按应付金额百分之五十以上百分之一百以下的标准向劳动者加付赔偿金：)
+ of(content, 劳动法第32行, （空行）)
+ of(content, 劳动法第330行, （一）未按照劳动合同的约定或者国家规定及时足额支付劳动者劳动报酬的；)
+ of(content, 劳动法第331行, （二）低于当地最低工资标准支付劳动者工资的；)
+ of(content, 劳动法第332行, （三）安排加班不支付加班费的；)
+ of(content, 劳动法第333行, （四）解除或者终止劳动合同，未依照本法规定向劳动者支付经济补偿的。)
+ of(content, 劳动法第334行, （空行）)
+ of(content, 劳动法第335行, 第八十六条劳动合同依照本法第二十六条规定被确认无效，给对方造成损害的，有过错的一方应当承担赔偿责任。)
+ of(content, 劳动法第336行, （空行）)
+ of(content, 劳动法第337行, 第八十七条用人单位违反本法规定解除或者终止劳动合同的，应当依照本法第四十七条规定的经济补偿标准的二倍向劳动者支付赔偿金。)
+ of(content, 劳动法第338行, （空行）)
+ of(content, 劳动法第339行, 第八十八条用人单位有下列情形之一的，依法给予行政处罚；构成犯罪的，依法追究刑事责任；给劳动者造成损害的，应当承担赔偿责任：)
+ of(content, 劳动法第33行, 第五条县级以上人民政府劳动行政部门会同工会和企业方面代表，建立健全协调劳动关系三方机制，共同研究解决有关劳动关系的重大问题。)
+ of(content, 劳动法第340行, （一）以暴力、威胁或者非法限制人身自由的手段强迫劳动的；)
+ of(content, 劳动法第341行, （二）违章指挥或者强令冒险作业危及劳动者人身安全的；)
+ of(content, 劳动法第342行, （三）侮辱、体罚、殴打、非法搜查或者拘禁劳动者的；)
+ of(content, 劳动法第343行, （四）劳动条件恶劣、环境污染严重，给劳动者身心健康造成严重损害的。)
+ of(content, 劳动法第344行, （空行）)
+ of(content, 劳动法第345行, 第八十九条用人单位违反本法规定未向劳动者出具解除或者终止劳动合同的书面证明，由劳动行政部门责令改正；给劳动者造成损害的，应当承担赔偿责任。)
+ of(content, 劳动法第346行, （空行）)
+ of(content, 劳动法第347行, 第九十条劳动者违反本法规定解除劳动合同，或者违反劳动合同中约定的保密义务或者竞业限制，给用人单位造成损失的，应当承担赔偿责任。)
+ of(content, 劳动法第348行, （空行）)
+ of(content, 劳动法第349行, 第九十一条用人单位招用与其他用人单位尚未解除或者终止劳动合同的劳动者，给其他用人单位造成损失的，应当承担连带赔偿责任。)
+ of(content, 劳动法第34行, （空行）)
+ of(content, 劳动法第350行, （空行）)
+ of(content, 劳动法第351行, 第九十二条违反本法规定，未经许可，擅自经营劳务派遣业务的，由劳动行政部门责令停止违法行为，没收违法所得，并处违法所得一倍以上五倍以下的罚款；没有违法所得的，可以处五万元以下的罚款。)
+ of(content, 劳动法第352行, （空行）)
+ of(content, 劳动法第353行, 第九十三条对不具备合法经营资格的用人单位的违法犯罪行为，依法追究法律责任；劳动者已经付出劳动的，该单位或者其出资人应当依照本法有关规定向劳动者支付劳动报酬、经济补偿、赔偿金；给劳动者造成损害的，应当承担赔偿责任。)
+ of(content, 劳动法第354行, （空行）)
+ of(content, 劳动法第355行, 第九十四条个人承包经营违反本法规定招用劳动者，给劳动者造成损害的，发包的组织与个人承包经营者承担连带赔偿责任。)
+ of(content, 劳动法第356行, （空行）)
+ of(content, 劳动法第357行, 第九十五条劳动行政部门和其他有关主管部门及其工作人员玩忽职守、不履行法定职责，或者违法行使职权，给劳动者或者用人单位造成损害的，应当承担赔偿责任；对直接负责的主管人员和其他直接责任人员，依法给予行政处分；构成犯罪的，依法追究刑事责任。)
+ of(content, 劳动法第358行, （空行）)
+ of(content, 劳动法第359行, ---)
+ of(content, 劳动法第35行, 第六条工会应当帮助、指导劳动者与用人单位依法订立和履行劳动合同，并与用人单位建立集体协商机制，维护劳动者的合法权益。)
+ of(content, 劳动法第360行, （空行）)
+ of(content, 劳动法第361行, 第八章附则)
+ of(content, 劳动法第362行, 第九十六条事业单位与实行聘用制的工作人员订立、履行、变更、解除或者终止劳动合同，法律、行政法规或者国务院另有规定的，依照其规定；未作规定的，依照本法有关规定执行。)
+ of(content, 劳动法第363行, （空行）)
+ of(content, 劳动法第364行, 第九十七条本法施行前已依法订立且在本法施行之日存续的劳动合同，继续履行；本法第十四条第二款第三项规定连续订立固定期限劳动合同的次数，自本法施行后续订固定期限劳动合同时开始计算。)
+ of(content, 劳动法第365行, 本法施行前已建立劳动关系，尚未订立书面劳动合同的，应当自本法施行之日起一个月内订立。)
+ of(content, 劳动法第366行, 本法施行之日存续的劳动合同在本法施行后解除或者终止，依照本法第四十六条规定应当支付经济补偿的，经济补偿年限自本法施行之日起计算；本法施行前按照当时有关规定，用人单位应当向劳动者支付经济补偿的，按照当时有关规定执行。)
+ of(content, 劳动法第367行, （空行）)
+ of(content, 劳动法第368行, 第九十八条本法自2008年1月1日起施行。)
+ of(content, 劳动法第36行, （空行）)
+ of(content, 劳动法第37行, ---)
+ of(content, 劳动法第38行, （空行）)
+ of(content, 劳动法第39行, 第二章劳动合同的订立)
+ of(content, 劳动法第3行, （空行）)
+ of(content, 劳动法第40行, 第七条用人单位自用工之日起即与劳动者建立劳动关系。用人单位应当建立职工名册备查。)
+ of(content, 劳动法第41行, （空行）)
+ of(content, 劳动法第42行, 第八条用人单位招用劳动者时，应当如实告知劳动者工作内容、工作条件、工作地点、职业危害、安全生产状况、劳动报酬，以及劳动者要求了解的其他情况；用人单位有权了解劳动者与劳动合同直接相关的基本情况，劳动者应当如实说明。)
+ of(content, 劳动法第43行, （空行）)
+ of(content, 劳动法第44行, 第九条用人单位招用劳动者，不得扣押劳动者的居民身份证和其他证件，不得要求劳动者提供担保或者以其他名义向劳动者收取财物。)
+ of(content, 劳动法第45行, （空行）)
+ of(content, 劳动法第46行, 第十条建立劳动关系，应当订立书面劳动合同。)
+ of(content, 劳动法第47行, 已建立劳动关系，未同时订立书面劳动合同的，应当自用工之日起一个月内订立书面劳动合同。)
+ of(content, 劳动法第48行, 用人单位与劳动者在用工前订立劳动合同的，劳动关系自用工之日起建立。)
+ of(content, 劳动法第49行, （空行）)
+ of(content, 劳动法第4行, 目录)
+ of(content, 劳动法第50行, 第十一条用人单位未在用工的同时订立书面劳动合同，与劳动者约定的劳动报酬不明确的，新招用的劳动者的劳动报酬按照集体合同规定的标准执行；没有集体合同或者集体合同未规定的，实行同工同酬。)
+ of(content, 劳动法第51行, （空行）)
+ of(content, 劳动法第52行, 第十二条劳动合同分为固定期限劳动合同、无固定期限劳动合同和以完成一定工作任务为期限的劳动合同。)
+ of(content, 劳动法第53行, （空行）)
+ of(content, 劳动法第54行, 第十三条固定期限劳动合同，是指用人单位与劳动者约定合同终止时间的劳动合同。)
+ of(content, 劳动法第55行, 用人单位与劳动者协商一致，可以订立固定期限劳动合同。)
+ of(content, 劳动法第56行, （空行）)
+ of(content, 劳动法第57行, 第十四条无固定期限劳动合同，是指用人单位与劳动者约定无确定终止时间的劳动合同。)
+ of(content, 劳动法第58行, 用人单位与劳动者协商一致，可以订立无固定期限劳动合同。有下列情形之一，劳动者提出或者同意续订、订立劳动合同的，除劳动者提出订立固定期限劳动合同外，应当订立无固定期限劳动合同：)
+ of(content, 劳动法第59行, （一）劳动者在该用人单位连续工作满十年的；)
+ of(content, 劳动法第5行, 第一章总则)
+ of(content, 劳动法第60行, （二）用人单位初次实行劳动合同制度或者国有企业改制重新订立劳动合同时，劳动者在该用人单位连续工作满十年且距法定退休年龄不足十年的；)
+ of(content, 劳动法第61行, （三）连续订立二次固定期限劳动合同，且劳动者没有本法第三十九条和第四十条第一项、第二项规定的情形，续订劳动合同的。)
+ of(content, 劳动法第62行, 用人单位自用工之日起满一年不与劳动者订立书面劳动合同的，视为用人单位与劳动者已订立无固定期限劳动合同。)
+ of(content, 劳动法第63行, （空行）)
+ of(content, 劳动法第64行, 第十五条以完成一定工作任务为期限的劳动合同，是指用人单位与劳动者约定以某项工作的完成为合同期限的劳动合同。)
+ of(content, 劳动法第65行, 用人单位与劳动者协商一致，可以订立以完成一定工作任务为期限的劳动合同。)
+ of(content, 劳动法第66行, （空行）)
+ of(content, 劳动法第67行, 第十六条劳动合同由用人单位与劳动者协商一致，并经用人单位与劳动者在劳动合同文本上签字或者盖章生效。)
+ of(content, 劳动法第68行, 劳动合同文本由用人单位和劳动者各执一份。)
+ of(content, 劳动法第69行, （空行）)
+ of(content, 劳动法第6行, 第二章劳动合同的订立)
+ of(content, 劳动法第70行, 第十七条劳动合同应当具备以下条款：)
+ of(content, 劳动法第71行, （一）用人单位的名称、住所和法定代表人或者主要负责人；)
+ of(content, 劳动法第72行, （二）劳动者的姓名、住址和居民身份证或者其他有效身份证件号码；)
+ of(content, 劳动法第73行, （三）劳动合同期限；)
+ of(content, 劳动法第74行, （四）工作内容和工作地点；)
+ of(content, 劳动法第75行, （五）工作时间和休息休假；)
+ of(content, 劳动法第76行, （六）劳动报酬；)
+ of(content, 劳动法第77行, （七）社会保险；)
+ of(content, 劳动法第78行, （八）劳动保护、劳动条件和职业危害防护；)
+ of(content, 劳动法第79行, （九）法律、法规规定应当纳入劳动合同的其他事项。)
+ of(content, 劳动法第7行, 第三章劳动合同的履行和变更)
+ of(content, 劳动法第80行, 劳动合同除前款规定的必备条款外，用人单位与劳动者可以约定试用期、培训、保守秘密、补充保险和福利待遇等其他事项。)
+ of(content, 劳动法第81行, （空行）)
+ of(content, 劳动法第82行, 第十八条劳动合同对劳动报酬和劳动条件等标准约定不明确，引发争议的，用人单位与劳动者可以重新协商；协商不成的，适用集体合同规定；没有集体合同或者集体合同未规定劳动报酬的，实行同工同酬；没有集体合同或者集体合同未规定劳动条件等标准的，适用国家有关规定。)
+ of(content, 劳动法第83行, （空行）)
+ of(content, 劳动法第84行, 第十九条劳动合同期限三个月以上不满一年的，试用期不得超过一个月；劳动合同期限一年以上不满三年的，试用期不得超过二个月；三年以上固定期限和无固定期限的劳动合同，试用期不得超过六个月。)
+ of(content, 劳动法第85行, 同一用人单位与同一劳动者只能约定一次试用期。)
+ of(content, 劳动法第86行, 以完成一定工作任务为期限的劳动合同或者劳动合同期限不满三个月的，不得约定试用期。)
+ of(content, 劳动法第87行, 试用期包含在劳动合同期限内。劳动合同仅约定试用期的，试用期不成立，该期限为劳动合同期限。)
+ of(content, 劳动法第88行, （空行）)
+ of(content, 劳动法第89行, 第二十条劳动者在试用期的工资不得低于本单位相同岗位最低档工资或者劳动合同约定工资的百分之八十，并不得低于用人单位所在地的最低工资标准。)
+ of(content, 劳动法第8行, 第四章劳动合同的解除和终止)
+ of(content, 劳动法第90行, （空行）)
+ of(content, 劳动法第91行, 第二十一条在试用期中，除劳动者有本法第三十九条和第四十条第一项、第二项规定的情形外，用人单位不得解除劳动合同。用人单位在试用期解除劳动合同的，应当向劳动者说明理由。)
+ of(content, 劳动法第92行, （空行）)
+ of(content, 劳动法第93行, 第二十二条用人单位为劳动者提供专项培训费用，对其进行专业技术培训的，可以与该劳动者订立协议，约定服务期。)
+ of(content, 劳动法第94行, 劳动者违反服务期约定的，应当按照约定向用人单位支付违约金。违约金的数额不得超过用人单位提供的培训费用。用人单位要求劳动者支付的违约金不得超过服务期尚未履行部分所应分摊的培训费用。)
+ of(content, 劳动法第95行, 用人单位与劳动者约定服务期的，不影响按照正常的工资调整机制提高劳动者在服务期期间的劳动报酬。)
+ of(content, 劳动法第96行, （空行）)
+ of(content, 劳动法第97行, 第二十三条用人单位与劳动者可以在劳动合同中约定保守用人单位的商业秘密和与知识产权相关的保密事项。)
+ of(content, 劳动法第98行, 对负有保密义务的劳动者，用人单位可以在劳动合同或者保密协议中与劳动者约定竞业限制条款，并约定在解除或者终止劳动合同后，在竞业限制期限内按月给予劳动者经济补偿。劳动者违反竞业限制约定的，应当按照约定向用人单位支付违约金。)
+ of(content, 劳动法第99行, （空行）)
+ of(content, 劳动法第9行, 第五章特别规定)
+ of(content, 第100行, 第二十四条竞业限制的人员限于用人单位的高级管理人员、高级技术人员和其他负有保密义务的人员。竞业限制的范围、地域、期限由用人单位与劳动者约定，竞业限制的约定不得违反法律、法规的规定。)
+ of(content, 第101行, 在解除或者终止劳动合同后，前款规定的人员到与本单位生产或者经营同类产品、从事同类业务的有竞争关系的其他用人单位，或者自己开业生产或者经营同类产品、从事同类业务的竞业限制期限，不得超过二年。)
+ of(content, 第102行, （空行）)
+ of(content, 第103行, 第二十五条除本法第二十二条和第二十三条规定的情形外，用人单位不得与劳动者约定由劳动者承担违约金。)
+ of(content, 第104行, （空行）)
+ of(content, 第105行, 第二十六条下列劳动合同无效或者部分无效：)
+ of(content, 第106行, （一）以欺诈、胁迫的手段或者乘人之危，使对方在违背真实意思的情况下订立或者变更劳动合同的；)
+ of(content, 第107行, （二）用人单位免除自己的法定责任、排除劳动者权利的；)
+ of(content, 第108行, （三）违反法律、行政法规强制性规定的。)
+ of(content, 第109行, 对劳动合同的无效或者部分无效有争议的，由劳动争议仲裁机构或者人民法院确认。)
+ of(content, 第10行, 第一节集体合同)
+ of(content, 第110行, （空行）)
+ of(content, 第111行, 第二十七条劳动合同部分无效，不影响其他部分效力的，其他部分仍然有效。)
+ of(content, 第112行, （空行）)
+ of(content, 第113行, 第二十八条劳动合同被确认无效，劳动者已付出劳动的，用人单位应当向劳动者支付劳动报酬。劳动报酬的数额，参照本单位相同或者相近岗位劳动者的劳动报酬确定。)
+ of(content, 第114行, （空行）)
+ of(content, 第115行, ---)
+ of(content, 第116行, （空行）)
+ of(content, 第117行, 第三章劳动合同的履行和变更)
+ of(content, 第118行, 第二十九条用人单位与劳动者应当按照劳动合同的约定，全面履行各自的义务。)
+ of(content, 第119行, （空行）)
+ of(content, 第11行, 第二节劳务派遣)
+ of(content, 第120行, 第三十条用人单位应当按照劳动合同约定和国家规定，向劳动者及时足额支付劳动报酬。)
+ of(content, 第121行, 用人单位拖欠或者未足额支付劳动报酬的，劳动者可以依法向当地人民法院申请支付令，人民法院应当依法发出支付令。)
+ of(content, 第122行, （空行）)
+ of(content, 第123行, 第三十一条用人单位应当严格执行劳动定额标准，不得强迫或者变相强迫劳动者加班。用人单位安排加班的，应当按照国家有关规定向劳动者支付加班费。)
+ of(content, 第124行, （空行）)
+ of(content, 第125行, 第三十二条劳动者拒绝用人单位管理人员违章指挥、强令冒险作业的，不视为违反劳动合同。)
+ of(content, 第126行, 劳动者对危害生命安全和身体健康的劳动条件，有权对用人单位提出批评、检举和控告。)
+ of(content, 第127行, （空行）)
+ of(content, 第128行, 第三十三条用人单位变更名称、法定代表人、主要负责人或者投资人等事项，不影响劳动合同的履行。)
+ of(content, 第129行, （空行）)
+ of(content, 第12行, 第三节非全日制用工)
+ of(content, 第130行, 第三十四条用人单位发生合并或者分立等情况，原劳动合同继续有效，劳动合同由承继其权利和义务的用人单位继续履行。)
+ of(content, 第131行, （空行）)
+ of(content, 第132行, 第三十五条用人单位与劳动者协商一致，可以变更劳动合同约定的内容。变更劳动合同，应当采用书面形式。)
+ of(content, 第133行, 变更后的劳动合同文本由用人单位和劳动者各执一份。)
+ of(content, 第134行, （空行）)
+ of(content, 第135行, ---)
+ of(content, 第136行, （空行）)
+ of(content, 第137行, 第四章劳动合同的解除和终止)
+ of(content, 第138行, 第三十六条用人单位与劳动者协商一致，可以解除劳动合同。)
+ of(content, 第139行, （空行）)
+ of(content, 第13行, 第六章监督检查)
+ of(content, 第140行, 第三十七条劳动者提前三十日以书面形式通知用人单位，可以解除劳动合同。劳动者在试用期内提前三日通知用人单位，可以解除劳动合同。)
+ of(content, 第141行, （空行）)
+ of(content, 第142行, 第三十八条用人单位有下列情形之一的，劳动者可以解除劳动合同：)
+ of(content, 第143行, （一）未按照劳动合同约定提供劳动保护或者劳动条件的；)
+ of(content, 第144行, （二）未及时足额支付劳动报酬的；)
+ of(content, 第145行, （三）未依法为劳动者缴纳社会保险费的；)
+ of(content, 第146行, （四）用人单位的规章制度违反法律、法规的规定，损害劳动者权益的；)
+ of(content, 第147行, （五）因本法第二十六条第一款规定的情形致使劳动合同无效的；)
+ of(content, 第148行, （六）法律、行政法规规定劳动者可以解除劳动合同的其他情形。)
+ of(content, 第149行, 用人单位以暴力、威胁或者非法限制人身自由的手段强迫劳动者劳动的，或者用人单位违章指挥、强令冒险作业危及劳动者人身安全的，劳动者可以立即解除劳动合同，不需事先告知用人单位。)
+ of(content, 第14行, 第七章法律责任)
+ of(content, 第150行, （空行）)
+ of(content, 第151行, 第三十九条劳动者有下列情形之一的，用人单位可以解除劳动合同：)
+ of(content, 第152行, （一）在试用期间被证明不符合录用条件的；)
+ of(content, 第153行, （二）严重违反用人单位的规章制度的；)
+ of(content, 第154行, （三）严重失职，营私舞弊，给用人单位造成重大损害的；)
+ of(content, 第155行, （四）劳动者同时与其他用人单位建立劳动关系，对完成本单位的工作任务造成严重影响，或者经用人单位提出，拒不改正的；)
+ of(content, 第156行, （五）因本法第二十六条第一款第一项规定的情形致使劳动合同无效的；)
+ of(content, 第157行, （六）被依法追究刑事责任的。)
+ of(content, 第158行, （空行）)
+ of(content, 第159行, 第四十条有下列情形之一的，用人单位提前三十日以书面形式通知劳动者本人或者额外支付劳动者一个月工资后，可以解除劳动合同：)
+ of(content, 第15行, 第八章附则)
+ of(content, 第160行, （一）劳动者患病或者非因工负伤，在规定的医疗期满后不能从事原工作，也不能从事由用人单位另行安排的工作的；)
+ of(content, 第161行, （二）劳动者不能胜任工作，经过培训或者调整工作岗位，仍不能胜任工作的；)
+ of(content, 第162行, （三）劳动合同订立时所依据的客观情况发生重大变化，致使劳动合同无法履行，经用人单位与劳动者协商，未能就变更劳动合同内容达成协议的。)
+ of(content, 第163行, （空行）)
+ of(content, 第164行, 第四十一条有下列情形之一，需要裁减人员二十人以上或者裁减不足二十人但占企业职工总数百分之十以上的，用人单位提前三十日向工会或者全体职工说明情况，听取工会或者职工的意见后，裁减人员方案经向劳动行政部门报告，可以裁减人员：)
+ of(content, 第165行, （一）依照企业破产法规定进行重整的；)
+ of(content, 第166行, （二）生产经营发生严重困难的；)
+ of(content, 第167行, （三）企业转产、重大技术革新或者经营方式调整，经变更劳动合同后，仍需裁减人员的；)
+ of(content, 第168行, （四）其他因劳动合同订立时所依据的客观经济情况发生重大变化，致使劳动合同无法履行的。)
+ of(content, 第169行, 裁减人员时，应当优先留用下列人员：)
+ of(content, 第16行, （空行）)
+ of(content, 第170行, （一）与本单位订立较长期限的固定期限劳动合同的；)
+ of(content, 第171行, （二）与本单位订立无固定期限劳动合同的；)
+ of(content, 第172行, （三）家庭无其他就业人员，有需要扶养的老人或者未成年人的。)
+ of(content, 第173行, 用人单位依照本条第一款规定裁减人员，在六个月内重新招用人员的，应当通知被裁减的人员，并在同等条件下优先招用被裁减的人员。)
+ of(content, 第174行, （空行）)
+ of(content, 第175行, 第四十二条劳动者有下列情形之一的，用人单位不得依照本法第四十条、第四十一条的规定解除劳动合同：)
+ of(content, 第176行, （一）从事接触职业病危害作业的劳动者未进行离岗前职业健康检查，或者疑似职业病病人在诊断或者医学观察期间的；)
+ of(content, 第177行, （二）在本单位患职业病或者因工负伤并被确认丧失或者部分丧失劳动能力的；)
+ of(content, 第178行, （三）患病或者非因工负伤，在规定的医疗期内的；)
+ of(content, 第179行, （四）女职工在孕期、产期、哺乳期的；)
+ of(content, 第17行, ---)
+ of(content, 第180行, （五）在本单位连续工作满十五年，且距法定退休年龄不足五年的；)
+ of(content, 第181行, （六）法律、行政法规规定的其他情形。)
+ of(content, 第182行, （空行）)
+ of(content, 第183行, 第四十三条用人单位单方解除劳动合同，应当事先将理由通知工会。用人单位违反法律、行政法规规定或者劳动合同约定的，工会有权要求用人单位纠正。用人单位应当研究工会的意见，并将处理结果书面通知工会。)
+ of(content, 第184行, （空行）)
+ of(content, 第185行, 第四十四条有下列情形之一的，劳动合同终止：)
+ of(content, 第186行, （一）劳动合同期满的；)
+ of(content, 第187行, （二）劳动者开始依法享受基本养老保险待遇的；)
+ of(content, 第188行, （三）劳动者死亡，或者被人民法院宣告死亡或者宣告失踪的；)
+ of(content, 第189行, （四）用人单位被依法宣告破产的；)
+ of(content, 第18行, （空行）)
+ of(content, 第190行, （五）用人单位被吊销营业执照、责令关闭、撤销或者用人单位决定提前解散的；)
+ of(content, 第191行, （六）法律、行政法规规定的其他情形。)
+ of(content, 第192行, （空行）)
+ of(content, 第193行, 第四十五条劳动合同期满，有本法第四十二条规定情形之一的，劳动合同应当续延至相应的情形消失时终止。但是，本法第四十二条第二项规定丧失或者部分丧失劳动能力劳动者的劳动合同的终止，按照国家有关工伤保险的规定执行。)
+ of(content, 第194行, （空行）)
+ of(content, 第195行, 第四十六条有下列情形之一的，用人单位应当向劳动者支付经济补偿：)
+ of(content, 第196行, （一）劳动者依照本法第三十八条规定解除劳动合同的；)
+ of(content, 第197行, （二）用人单位依照本法第三十六条规定向劳动者提出解除劳动合同并与劳动者协商一致解除劳动合同的；)
+ of(content, 第198行, （三）用人单位依照本法第四十条规定解除劳动合同的；)
+ of(content, 第199行, （四）用人单位依照本法第四十一条第一款规定解除劳动合同的；)
+ of(content, 第19行, 第一章总则)
+ of(content, 第1行, 中华人民共和国劳动合同法)
+ of(content, 第200行, （五）除用人单位维持或者提高劳动合同约定条件续订劳动合同，劳动者不同意续订的情形外，依照本法第四十四条第一项规定终止固定期限劳动合同的；)
+ of(content, 第201行, （六）依照本法第四十四条第四项、第五项规定终止劳动合同的；)
+ of(content, 第202行, （七）法律、行政法规规定的其他情形。)
+ of(content, 第203行, （空行）)
+ of(content, 第204行, 第四十七条经济补偿按劳动者在本单位工作的年限，每满一年支付一个月工资的标准向劳动者支付。六个月以上不满一年的，按一年计算；不满六个月的，向劳动者支付半个月工资的经济补偿。)
+ of(content, 第205行, 劳动者月工资高于用人单位所在直辖市、设区的市级人民政府公布的本地区上年度职工月平均工资三倍的，向其支付经济补偿的标准按职工月平均工资三倍的数额支付，向其支付经济补偿的年限最高不超过十二年。)
+ of(content, 第206行, 本条所称月工资是指劳动者在劳动合同解除或者终止前十二个月的平均工资。)
+ of(content, 第207行, （空行）)
+ of(content, 第208行, 第四十八条用人单位违反本法规定解除或者终止劳动合同，劳动者要求继续履行劳动合同的，用人单位应当继续履行；劳动者不要求继续履行劳动合同或者劳动合同已经不能继续履行的，用人单位应当依照本法第八十七条规定支付赔偿金。)
+ of(content, 第209行, （空行）)
+ of(content, 第20行, 第一条为了完善劳动合同制度，明确劳动合同双方当事人的权利和义务，保护劳动者的合法权益，构建和发展和谐稳定的劳动关系，制定本法。)
+ of(content, 第210行, 第四十九条国家采取措施，建立健全劳动者社会保险关系跨地区转移接续制度。)
+ of(content, 第211行, （空行）)
+ of(content, 第212行, 第五十条用人单位应当在解除或者终止劳动合同时出具解除或者终止劳动合同的证明，并在十五日内为劳动者办理档案和社会保险关系转移手续。)
+ of(content, 第213行, 劳动者应当按照双方约定，办理工作交接。用人单位依照本法有关规定应当向劳动者支付经济补偿的，在办结工作交接时支付。)
+ of(content, 第214行, 用人单位对已经解除或者终止的劳动合同的文本，至少保存二年备查。)
+ of(content, 第215行, （空行）)
+ of(content, 第216行, ---)
+ of(content, 第217行, （空行）)
+ of(content, 第218行, 第五章特别规定)
+ of(content, 第219行, 第一节集体合同)
+ of(content, 第21行, （空行）)
+ of(content, 第220行, 第五十一条企业职工一方与用人单位通过平等协商，可以就劳动报酬、工作时间、休息休假、劳动安全卫生、保险福利等事项订立集体合同。集体合同草案应当提交职工代表大会或者全体职工讨论通过。)
+ of(content, 第221行, 集体合同由工会代表企业职工一方与用人单位订立；尚未建立工会的用人单位，由上级工会指导劳动者推举的代表与用人单位订立。)
+ of(content, 第222行, （空行）)
+ of(content, 第223行, 第五十二条企业职工一方与用人单位可以订立劳动安全卫生、女职工权益保护、工资调整机制等专项集体合同。)
+ of(content, 第224行, （空行）)
+ of(content, 第225行, 第五十三条在县级以下区域内，建筑业、采矿业、餐饮服务业等行业可以由工会与企业方面代表订立行业性集体合同，或者订立区域性集体合同。)
+ of(content, 第226行, （空行）)
+ of(content, 第227行, 第五十四条集体合同订立后，应当报送劳动行政部门；劳动行政部门自收到集体合同文本之日起十五日内未提出异议的，集体合同即行生效。)
+ of(content, 第228行, 依法订立的集体合同对用人单位和劳动者具有约束力。行业性、区域性集体合同对当地本行业、本区域的用人单位和劳动者具有约束力。)
+ of(content, 第229行, （空行）)
+ of(content, 第22行, 第二条中华人民共和国境内的企业、个体经济组织、民办非企业单位等组织（以下称用人单位）与劳动者建立劳动关系，订立、履行、变更、解除或者终止劳动合同，适用本法。)
+ of(content, 第230行, 第五十五条集体合同中劳动报酬和劳动条件等标准不得低于当地人民政府规定的最低标准；用人单位与劳动者订立的劳动合同中劳动报酬和劳动条件等标准不得低于集体合同规定的标准。)
+ of(content, 第231行, （空行）)
+ of(content, 第232行, 第五十六条用人单位违反集体合同，侵犯职工劳动权益的，工会可以依法要求用人单位承担责任；因履行集体合同发生争议，经协商解决不成的，工会可以依法申请仲裁、提起诉讼。)
+ of(content, 第233行, （空行）)
+ of(content, 第234行, 第二节劳务派遣)
+ of(content, 第235行, 第五十七条经营劳务派遣业务应当具备下列条件：)
+ of(content, 第236行, （一）注册资本不得少于人民币二百万元；)
+ of(content, 第237行, （二）有与开展业务相适应的固定的经营场所和设施；)
+ of(content, 第238行, （三）有符合法律、行政法规规定的劳务派遣管理制度；)
+ of(content, 第239行, （四）法律、行政法规规定的其他条件。)
+ of(content, 第23行, 国家机关、事业单位、社会团体和与其建立劳动关系的劳动者，订立、履行、变更、解除或者终止劳动合同，依照本法执行。)
+ of(content, 第240行, 经营劳务派遣业务，应当向劳动行政部门依法申请行政许可；经许可的，依法办理相应的公司登记。未经许可，任何单位和个人不得经营劳务派遣业务。)
+ of(content, 第241行, （空行）)
+ of(content, 第242行, 第五十八条劳务派遣单位是本法所称用人单位，应当履行用人单位对劳动者的义务。劳务派遣单位与被派遣劳动者订立的劳动合同，除应当载明本法第十七条规定的事项外，还应当载明被派遣劳动者的用工单位以及派遣期限、工作岗位等情况。)
+ of(content, 第243行, 劳务派遣单位应当与被派遣劳动者订立二年以上的固定期限劳动合同，按月支付劳动报酬；被派遣劳动者在无工作期间，劳务派遣单位应当按照所在地人民政府规定的最低工资标准，向其按月支付报酬。)
+ of(content, 第244行, （空行）)
+ of(content, 第245行, 第五十九条劳务派遣单位派遣劳动者应当与接受以劳务派遣形式用工的单位（以下称用工单位）订立劳务派遣协议。劳务派遣协议应当约定派遣岗位和人员数量、派遣期限、劳动报酬和社会保险费的数额与支付方式以及违反协议的责任。)
+ of(content, 第246行, 用工单位应当根据工作岗位的实际需要与劳务派遣单位确定派遣期限，不得将连续用工期限分割订立数个短期劳务派遣协议。)
+ of(content, 第247行, （空行）)
+ of(content, 第248行, 第六十条劳务派遣单位应当将劳务派遣协议的内容告知被派遣劳动者。)
+ of(content, 第249行, 劳务派遣单位不得克扣用工单位按照劳务派遣协议支付给被派遣劳动者的劳动报酬。)
+ of(content, 第24行, （空行）)
+ of(content, 第250行, 劳务派遣单位和用工单位不得向被派遣劳动者收取费用。)
+ of(content, 第251行, （空行）)
+ of(content, 第252行, 第六十一条劳务派遣单位跨地区派遣劳动者的，被派遣劳动者享有的劳动报酬和劳动条件，按照用工单位所在地的标准执行。)
+ of(content, 第253行, （空行）)
+ of(content, 第254行, 第六十二条用工单位应当履行下列义务：)
+ of(content, 第255行, （一）执行国家劳动标准，提供相应的劳动条件和劳动保护；)
+ of(content, 第256行, （二）告知被派遣劳动者的工作要求和劳动报酬；)
+ of(content, 第257行, （三）支付加班费、绩效奖金，提供与工作岗位相关的福利待遇；)
+ of(content, 第258行, （四）对在岗被派遣劳动者进行工作岗位所必需的培训；)
+ of(content, 第259行, （五）连续用工的，实行正常的工资调整机制。)
+ of(content, 第25行, 第三条订立劳动合同，应当遵循合法、公平、平等自愿、协商一致、诚实信用的原则。)
+ of(content, 第260行, 用工单位不得将被派遣劳动者再派遣到其他用人单位。)
+ of(content, 第261行, （空行）)
+ of(content, 第262行, 第六十三条被派遣劳动者享有与用工单位的劳动者同工同酬的权利。用工单位应当按照同工同酬原则，对被派遣劳动者与本单位同类岗位的劳动者实行相同的劳动报酬分配办法。用工单位无同类岗位劳动者的，参照用工单位所在地相同或者相近岗位劳动者的劳动报酬确定。)
+ of(content, 第263行, （空行）)
+ of(content, 第264行, 第六十四条被派遣劳动者有权在劳务派遣单位或者用工单位依法参加或者组织工会，维护自身的合法权益。)
+ of(content, 第265行, （空行）)
+ of(content, 第266行, 第六十五条被派遣劳动者可以依照本法第三十六条、第三十八条的规定与劳务派遣单位解除劳动合同。)
+ of(content, 第267行, 被派遣劳动者有本法第三十九条和第四十条第一项、第二项规定情形的，用工单位可以将劳动者退回劳务派遣单位，劳务派遣单位依照本法有关规定，可以与劳动者解除劳动合同。)
+ of(content, 第268行, （空行）)
+ of(content, 第269行, 第六十六条劳动合同用工是我国的企业基本用工形式。劳务派遣用工是补充形式，只能在临时性、辅助性或者替代性的工作岗位上实施。)
+ of(content, 第26行, 依法订立的劳动合同具有约束力，用人单位与劳动者应当履行劳动合同约定的义务。)
+ of(content, 第270行, （空行）)
+ of(content, 第271行, 第六十七条用人单位不得设立劳务派遣单位向本单位或者所属单位派遣劳动者。)
+ of(content, 第272行, （空行）)
+ of(content, 第273行, 第三节非全日制用工)
+ of(content, 第274行, 第六十八条非全日制用工，是指以小时计酬为主，劳动者在同一用人单位一般平均每日工作时间不超过四小时，每周工作时间累计不超过二十四小时的用工形式。)
+ of(content, 第275行, （空行）)
+ of(content, 第276行, 第六十九条非全日制用工双方当事人可以订立口头协议。)
+ of(content, 第277行, 从事非全日制用工的劳动者可以与一个或者一个以上用人单位订立劳动合同；但是，后订立的劳动合同不得影响先订立的劳动合同的履行。)
+ of(content, 第278行, （空行）)
+ of(content, 第279行, 第七十条非全日制用工双方当事人不得约定试用期。)
+ of(content, 第27行, （空行）)
+ of(content, 第280行, （空行）)
+ of(content, 第281行, 第七十一条非全日制用工双方当事人任何一方都可以随时通知对方终止用工。终止用工，用人单位不向劳动者支付经济补偿。)
+ of(content, 第282行, （空行）)
+ of(content, 第283行, 第七十二条非全日制用工小时计酬标准不得低于用人单位所在地人民政府规定的最低小时工资标准。)
+ of(content, 第284行, 非全日制用工劳动报酬结算支付周期最长不得超过十五日。)
+ of(content, 第285行, （空行）)
+ of(content, 第286行, ---)
+ of(content, 第287行, （空行）)
+ of(content, 第288行, 第六章监督检查)
+ of(content, 第289行, 第七十三条国务院劳动行政部门负责全国劳动合同制度实施的监督管理。)
+ of(content, 第28行, 第四条用人单位应当依法建立和完善劳动规章制度，保障劳动者享有劳动权利、履行劳动义务。)
+ of(content, 第290行, 县级以上地方人民政府劳动行政部门负责本行政区域内劳动合同制度实施的监督管理。)
+ of(content, 第291行, 县级以上各级人民政府劳动行政部门在劳动合同制度实施的监督管理工作中，应当听取工会、企业方面代表以及有关行业主管部门的意见。)
+ of(content, 第292行, （空行）)
+ of(content, 第293行, 第七十四条县级以上地方人民政府劳动行政部门依法对下列实施劳动合同制度的情况进行监督检查：)
+ of(content, 第294行, （一）用人单位制定直接涉及劳动者切身利益的规章制度及其执行的情况；)
+ of(content, 第295行, （二）用人单位与劳动者订立和解除劳动合同的情况；)
+ of(content, 第296行, （三）劳务派遣单位和用工单位遵守劳务派遣有关规定的情况；)
+ of(content, 第297行, （四）用人单位遵守国家关于劳动者工作时间和休息休假规定的情况；)
+ of(content, 第298行, （五）用人单位支付劳动合同约定的劳动报酬和执行最低工资标准的情况；)
+ of(content, 第299行, （六）用人单位参加各项社会保险和缴纳社会保险费的情况；)
+ of(content, 第29行, 用人单位在制定、修改或者决定有关劳动报酬、工作时间、休息休假、劳动安全卫生、保险福利、职工培训、劳动纪律以及劳动定额管理等直接涉及劳动者切身利益的规章制度或者重大事项时，应当经职工代表大会或者全体职工讨论，提出方案和意见，与工会或者职工代表平等协商确定。)
+ of(content, 第2行, （2007年6月29日第十届全国人民代表大会常务委员会第二十八次会议通过，2012年修正）)
+ of(content, 第300行, （七）法律、法规规定的其他劳动监察事项。)
+ of(content, 第301行, （空行）)
+ of(content, 第302行, 第七十五条县级以上地方人民政府劳动行政部门实施监督检查时，有权查阅与劳动合同、集体合同有关的材料，有权对劳动场所进行实地检查，用人单位和劳动者都应当如实提供有关情况和材料。)
+ of(content, 第303行, 劳动行政部门的工作人员进行监督检查，应当出示证件，依法行使职权，文明执法。)
+ of(content, 第304行, （空行）)
+ of(content, 第305行, 第七十六条县级以上人民政府建设、卫生、安全生产监督管理等有关主管部门在各自职责范围内，对用人单位执行劳动合同制度的情况进行监督管理。)
+ of(content, 第306行, （空行）)
+ of(content, 第307行, 第七十七条劳动者合法权益受到侵害的，有权要求有关部门依法处理，或者依法申请仲裁、提起诉讼。)
+ of(content, 第308行, （空行）)
+ of(content, 第309行, 第七十八条工会依法维护劳动者的合法权益，对用人单位履行劳动合同、集体合同的情况进行监督。用人单位违反劳动法律、法规和劳动合同、集体合同的，工会有权提出意见或者要求纠正；劳动者申请仲裁、提起诉讼的，工会依法给予支持和帮助。)
+ of(content, 第30行, 在规章制度和重大事项决定实施过程中，工会或者职工认为不适当的，有权向用人单位提出，通过协商予以修改完善。)
+ of(content, 第310行, （空行）)
+ of(content, 第311行, 第七十九条任何组织或者个人对违反本法的行为都有权举报，县级以上人民政府劳动行政部门应当及时核实、处理，并对举报有功人员给予奖励。)
+ of(content, 第312行, （空行）)
+ of(content, 第313行, ---)
+ of(content, 第314行, （空行）)
+ of(content, 第315行, 第七章法律责任)
+ of(content, 第316行, 第八十条用人单位直接涉及劳动者切身利益的规章制度违反法律、法规规定的，由劳动行政部门责令改正，给予警告；给劳动者造成损害的，应当承担赔偿责任。)
+ of(content, 第317行, （空行）)
+ of(content, 第318行, 第八十一条用人单位提供的劳动合同文本未载明本法规定的劳动合同必备条款或者用人单位未将劳动合同文本交付劳动者的，由劳动行政部门责令改正；给劳动者造成损害的，应当承担赔偿责任。)
+ of(content, 第319行, （空行）)
+ of(content, 第31行, 用人单位应当将直接涉及劳动者切身利益的规章制度和重大事项决定公示，或者告知劳动者。)
+ of(content, 第320行, 第八十二条用人单位自用工之日起超过一个月不满一年未与劳动者订立书面劳动合同的，应当向劳动者每月支付二倍的工资。)
+ of(content, 第321行, 用人单位违反本法规定不与劳动者订立无固定期限劳动合同的，自应当订立无固定期限劳动合同之日起向劳动者每月支付二倍的工资。)
+ of(content, 第322行, （空行）)
+ of(content, 第323行, 第八十三条用人单位违反本法规定与劳动者约定试用期的，由劳动行政部门责令改正；违法约定的试用期已经履行的，由用人单位以劳动者试用期满月工资为标准，按已经履行的超过法定试用期的期间向劳动者支付赔偿金。)
+ of(content, 第324行, （空行）)
+ of(content, 第325行, 第八十四条用人单位违反本法规定，扣押劳动者居民身份证等证件的，由劳动行政部门责令限期退还劳动者本人，并依照有关法律规定给予处罚。)
+ of(content, 第326行, 用人单位违反本法规定，以担保或者其他名义向劳动者收取财物的，由劳动行政部门责令限期退还劳动者本人，并以每人五百元以上二千元以下的标准处以罚款；给劳动者造成损害的，应当承担赔偿责任。)
+ of(content, 第327行, 劳动者依法解除或者终止劳动合同，用人单位扣押劳动者档案或者其他物品的，依照前款规定处罚。)
+ of(content, 第328行, （空行）)
+ of(content, 第329行, 第八十五条用人单位有下列情形之一的，由劳动行政部门责令限期支付劳动报酬、加班费或者经济补偿；劳动报酬低于当地最低工资标准的，应当支付其差额部分；逾期不支付的，责令用人单位按应付金额百分之五十以上百分之一百以下的标准向劳动者加付赔偿金：)
+ of(content, 第32行, （空行）)
+ of(content, 第330行, （一）未按照劳动合同的约定或者国家规定及时足额支付劳动者劳动报酬的；)
+ of(content, 第331行, （二）低于当地最低工资标准支付劳动者工资的；)
+ of(content, 第332行, （三）安排加班不支付加班费的；)
+ of(content, 第333行, （四）解除或者终止劳动合同，未依照本法规定向劳动者支付经济补偿的。)
+ of(content, 第334行, （空行）)
+ of(content, 第335行, 第八十六条劳动合同依照本法第二十六条规定被确认无效，给对方造成损害的，有过错的一方应当承担赔偿责任。)
+ of(content, 第336行, （空行）)
+ of(content, 第337行, 第八十七条用人单位违反本法规定解除或者终止劳动合同的，应当依照本法第四十七条规定的经济补偿标准的二倍向劳动者支付赔偿金。)
+ of(content, 第338行, （空行）)
+ of(content, 第339行, 第八十八条用人单位有下列情形之一的，依法给予行政处罚；构成犯罪的，依法追究刑事责任；给劳动者造成损害的，应当承担赔偿责任：)
+ of(content, 第33行, 第五条县级以上人民政府劳动行政部门会同工会和企业方面代表，建立健全协调劳动关系三方机制，共同研究解决有关劳动关系的重大问题。)
+ of(content, 第340行, （一）以暴力、威胁或者非法限制人身自由的手段强迫劳动的；)
+ of(content, 第341行, （二）违章指挥或者强令冒险作业危及劳动者人身安全的；)
+ of(content, 第342行, （三）侮辱、体罚、殴打、非法搜查或者拘禁劳动者的；)
+ of(content, 第343行, （四）劳动条件恶劣、环境污染严重，给劳动者身心健康造成严重损害的。)
+ of(content, 第344行, （空行）)
+ of(content, 第345行, 第八十九条用人单位违反本法规定未向劳动者出具解除或者终止劳动合同的书面证明，由劳动行政部门责令改正；给劳动者造成损害的，应当承担赔偿责任。)
+ of(content, 第346行, （空行）)
+ of(content, 第347行, 第九十条劳动者违反本法规定解除劳动合同，或者违反劳动合同中约定的保密义务或者竞业限制，给用人单位造成损失的，应当承担赔偿责任。)
+ of(content, 第348行, （空行）)
+ of(content, 第349行, 第九十一条用人单位招用与其他用人单位尚未解除或者终止劳动合同的劳动者，给其他用人单位造成损失的，应当承担连带赔偿责任。)
+ of(content, 第34行, （空行）)
+ of(content, 第350行, （空行）)
+ of(content, 第351行, 第九十二条违反本法规定，未经许可，擅自经营劳务派遣业务的，由劳动行政部门责令停止违法行为，没收违法所得，并处违法所得一倍以上五倍以下的罚款；没有违法所得的，可以处五万元以下的罚款。)
+ of(content, 第352行, （空行）)
+ of(content, 第353行, 第九十三条对不具备合法经营资格的用人单位的违法犯罪行为，依法追究法律责任；劳动者已经付出劳动的，该单位或者其出资人应当依照本法有关规定向劳动者支付劳动报酬、经济补偿、赔偿金；给劳动者造成损害的，应当承担赔偿责任。)
+ of(content, 第354行, （空行）)
+ of(content, 第355行, 第九十四条个人承包经营违反本法规定招用劳动者，给劳动者造成损害的，发包的组织与个人承包经营者承担连带赔偿责任。)
+ of(content, 第356行, （空行）)
+ of(content, 第357行, 第九十五条劳动行政部门和其他有关主管部门及其工作人员玩忽职守、不履行法定职责，或者违法行使职权，给劳动者或者用人单位造成损害的，应当承担赔偿责任；对直接负责的主管人员和其他直接责任人员，依法给予行政处分；构成犯罪的，依法追究刑事责任。)
+ of(content, 第358行, （空行）)
+ of(content, 第359行, ---)
+ of(content, 第35行, 第六条工会应当帮助、指导劳动者与用人单位依法订立和履行劳动合同，并与用人单位建立集体协商机制，维护劳动者的合法权益。)
+ of(content, 第360行, （空行）)
+ of(content, 第361行, 第八章附则)
+ of(content, 第362行, 第九十六条事业单位与实行聘用制的工作人员订立、履行、变更、解除或者终止劳动合同，法律、行政法规或者国务院另有规定的，依照其规定；未作规定的，依照本法有关规定执行。)
+ of(content, 第363行, （空行）)
+ of(content, 第364行, 第九十七条本法施行前已依法订立且在本法施行之日存续的劳动合同，继续履行；本法第十四条第二款第三项规定连续订立固定期限劳动合同的次数，自本法施行后续订固定期限劳动合同时开始计算。)
+ of(content, 第365行, 本法施行前已建立劳动关系，尚未订立书面劳动合同的，应当自本法施行之日起一个月内订立。)
+ of(content, 第366行, 本法施行之日存续的劳动合同在本法施行后解除或者终止，依照本法第四十六条规定应当支付经济补偿的，经济补偿年限自本法施行之日起计算；本法施行前按照当时有关规定，用人单位应当向劳动者支付经济补偿的，按照当时有关规定执行。)
+ of(content, 第367行, （空行）)
+ of(content, 第368行, 第九十八条本法自2008年1月1日起施行。)
+ of(content, 第36行, （空行）)
+ of(content, 第37行, ---)
+ of(content, 第38行, （空行）)
+ of(content, 第39行, 第二章劳动合同的订立)
+ of(content, 第3行, （空行）)
+ of(content, 第40行, 第七条用人单位自用工之日起即与劳动者建立劳动关系。用人单位应当建立职工名册备查。)
+ of(content, 第41行, （空行）)
+ of(content, 第42行, 第八条用人单位招用劳动者时，应当如实告知劳动者工作内容、工作条件、工作地点、职业危害、安全生产状况、劳动报酬，以及劳动者要求了解的其他情况；用人单位有权了解劳动者与劳动合同直接相关的基本情况，劳动者应当如实说明。)
+ of(content, 第43行, （空行）)
+ of(content, 第44行, 第九条用人单位招用劳动者，不得扣押劳动者的居民身份证和其他证件，不得要求劳动者提供担保或者以其他名义向劳动者收取财物。)
+ of(content, 第45行, （空行）)
+ of(content, 第46行, 第十条建立劳动关系，应当订立书面劳动合同。)
+ of(content, 第47行, 已建立劳动关系，未同时订立书面劳动合同的，应当自用工之日起一个月内订立书面劳动合同。)
+ of(content, 第48行, 用人单位与劳动者在用工前订立劳动合同的，劳动关系自用工之日起建立。)
+ of(content, 第49行, （空行）)
+ of(content, 第4行, 目录)
+ of(content, 第50行, 第十一条用人单位未在用工的同时订立书面劳动合同，与劳动者约定的劳动报酬不明确的，新招用的劳动者的劳动报酬按照集体合同规定的标准执行；没有集体合同或者集体合同未规定的，实行同工同酬。)
+ of(content, 第51行, （空行）)
+ of(content, 第52行, 第十二条劳动合同分为固定期限劳动合同、无固定期限劳动合同和以完成一定工作任务为期限的劳动合同。)
+ of(content, 第53行, （空行）)
+ of(content, 第54行, 第十三条固定期限劳动合同，是指用人单位与劳动者约定合同终止时间的劳动合同。)
+ of(content, 第55行, 用人单位与劳动者协商一致，可以订立固定期限劳动合同。)
+ of(content, 第56行, （空行）)
+ of(content, 第57行, 第十四条无固定期限劳动合同，是指用人单位与劳动者约定无确定终止时间的劳动合同。)
+ of(content, 第58行, 用人单位与劳动者协商一致，可以订立无固定期限劳动合同。有下列情形之一，劳动者提出或者同意续订、订立劳动合同的，除劳动者提出订立固定期限劳动合同外，应当订立无固定期限劳动合同：)
+ of(content, 第59行, （一）劳动者在该用人单位连续工作满十年的；)
+ of(content, 第5行, 第一章总则)
+ of(content, 第60行, （二）用人单位初次实行劳动合同制度或者国有企业改制重新订立劳动合同时，劳动者在该用人单位连续工作满十年且距法定退休年龄不足十年的；)
+ of(content, 第61行, （三）连续订立二次固定期限劳动合同，且劳动者没有本法第三十九条和第四十条第一项、第二项规定的情形，续订劳动合同的。)
+ of(content, 第62行, 用人单位自用工之日起满一年不与劳动者订立书面劳动合同的，视为用人单位与劳动者已订立无固定期限劳动合同。)
+ of(content, 第63行, （空行）)
+ of(content, 第64行, 第十五条以完成一定工作任务为期限的劳动合同，是指用人单位与劳动者约定以某项工作的完成为合同期限的劳动合同。)
+ of(content, 第65行, 用人单位与劳动者协商一致，可以订立以完成一定工作任务为期限的劳动合同。)
+ of(content, 第66行, （空行）)
+ of(content, 第67行, 第十六条劳动合同由用人单位与劳动者协商一致，并经用人单位与劳动者在劳动合同文本上签字或者盖章生效。)
+ of(content, 第68行, 劳动合同文本由用人单位和劳动者各执一份。)
+ of(content, 第69行, （空行）)
+ of(content, 第6行, 第二章劳动合同的订立)
+ of(content, 第70行, 第十七条劳动合同应当具备以下条款：)
+ of(content, 第71行, （一）用人单位的名称、住所和法定代表人或者主要负责人；)
+ of(content, 第72行, （二）劳动者的姓名、住址和居民身份证或者其他有效身份证件号码；)
+ of(content, 第73行, （三）劳动合同期限；)
+ of(content, 第74行, （四）工作内容和工作地点；)
+ of(content, 第75行, （五）工作时间和休息休假；)
+ of(content, 第76行, （六）劳动报酬；)
+ of(content, 第77行, （七）社会保险；)
+ of(content, 第78行, （八）劳动保护、劳动条件和职业危害防护；)
+ of(content, 第79行, （九）法律、法规规定应当纳入劳动合同的其他事项。)
+ of(content, 第7行, 第三章劳动合同的履行和变更)
+ of(content, 第80行, 劳动合同除前款规定的必备条款外，用人单位与劳动者可以约定试用期、培训、保守秘密、补充保险和福利待遇等其他事项。)
+ of(content, 第81行, （空行）)
+ of(content, 第82行, 第十八条劳动合同对劳动报酬和劳动条件等标准约定不明确，引发争议的，用人单位与劳动者可以重新协商；协商不成的，适用集体合同规定；没有集体合同或者集体合同未规定劳动报酬的，实行同工同酬；没有集体合同或者集体合同未规定劳动条件等标准的，适用国家有关规定。)
+ of(content, 第83行, （空行）)
+ of(content, 第84行, 第十九条劳动合同期限三个月以上不满一年的，试用期不得超过一个月；劳动合同期限一年以上不满三年的，试用期不得超过二个月；三年以上固定期限和无固定期限的劳动合同，试用期不得超过六个月。)
+ of(content, 第85行, 同一用人单位与同一劳动者只能约定一次试用期。)
+ of(content, 第86行, 以完成一定工作任务为期限的劳动合同或者劳动合同期限不满三个月的，不得约定试用期。)
+ of(content, 第87行, 试用期包含在劳动合同期限内。劳动合同仅约定试用期的，试用期不成立，该期限为劳动合同期限。)
+ of(content, 第88行, （空行）)
+ of(content, 第89行, 第二十条劳动者在试用期的工资不得低于本单位相同岗位最低档工资或者劳动合同约定工资的百分之八十，并不得低于用人单位所在地的最低工资标准。)
+ of(content, 第8行, 第四章劳动合同的解除和终止)
+ of(content, 第90行, （空行）)
+ of(content, 第91行, 第二十一条在试用期中，除劳动者有本法第三十九条和第四十条第一项、第二项规定的情形外，用人单位不得解除劳动合同。用人单位在试用期解除劳动合同的，应当向劳动者说明理由。)
+ of(content, 第92行, （空行）)
+ of(content, 第93行, 第二十二条用人单位为劳动者提供专项培训费用，对其进行专业技术培训的，可以与该劳动者订立协议，约定服务期。)
+ of(content, 第94行, 劳动者违反服务期约定的，应当按照约定向用人单位支付违约金。违约金的数额不得超过用人单位提供的培训费用。用人单位要求劳动者支付的违约金不得超过服务期尚未履行部分所应分摊的培训费用。)
+ of(content, 第95行, 用人单位与劳动者约定服务期的，不影响按照正常的工资调整机制提高劳动者在服务期期间的劳动报酬。)
+ of(content, 第96行, （空行）)
+ of(content, 第97行, 第二十三条用人单位与劳动者可以在劳动合同中约定保守用人单位的商业秘密和与知识产权相关的保密事项。)
+ of(content, 第98行, 对负有保密义务的劳动者，用人单位可以在劳动合同或者保密协议中与劳动者约定竞业限制条款，并约定在解除或者终止劳动合同后，在竞业限制期限内按月给予劳动者经济补偿。劳动者违反竞业限制约定的，应当按照约定向用人单位支付违约金。)
+ of(content, 第99行, （空行）)
+ of(content, 第9行, 第五章特别规定)
